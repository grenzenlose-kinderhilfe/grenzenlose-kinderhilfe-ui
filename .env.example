# Build settings. Copy to .env for local builds; in GitHub Actions they come
# from the repository variables of the same name. A variable set in the
# environment wins over the value in .env.

# Required: the content spreadsheet's id, from its URL
# https://docs.google.com/spreadsheets/d/<id>/edit
PUBLIC_GOOGLE_SHEET_ID=

# Optional: the Stripe customer portal login link, where monthly donors update
# their card or cancel (Stripe: Settings → Billing → Customer portal); the
# "manage your donation" links are hidden while empty.
PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=

# Optional: Google Analytics measurement ID ("G-…"); no tracking while empty,
# and never under `pnpm dev`.
PUBLIC_GA_MEASUREMENT_ID=

---
import { getTranslator, localizePath } from "../i18n";

/**
 * Asks for consent to the statistics cookies (Google Analytics) on the first
 * visit, and opens again from any `[data-cookie-settings]` button (footer,
 * cookie policy). Rejecting is as easy as accepting: both are on the first
 * screen. The stored choice is handled by src/lib/consent.js.
 *
 * Only rendered while Analytics is configured; without it the site sets no
 * cookies and there is nothing to ask.
 */
interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const text = (key: string) => t(`ui.cookies.${key}`);
---

<section
  class="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
  data-cookie-banner
  hidden
>
  <h2 id="cookie-banner-title" tabindex="-1">
    {text("title")}
  </h2>
  <p id="cookie-banner-text">
    {text("text")}{" "}
    <a class="cookie-policy-link" href={localizePath(locale, "/legal/cookies")}>
      {text("policyLink")}
    </a>
  </p>

  <div class="cookie-options" data-cookie-options hidden>
    <label class="cookie-option">
      <span class="cookie-option-text">
        <strong>{text("necessary")}</strong>
        <span>{text("necessaryDescription")}</span>
      </span>
      <input type="checkbox" class="cookie-switch" checked disabled />
    </label>
    <label class="cookie-option">
      <span class="cookie-option-text">
        <strong>{text("statistics")}</strong>
        <span>{text("statisticsDescription")}</span>
      </span>
      <input type="checkbox" class="cookie-switch" data-cookie-analytics />
    </label>
  </div>

  <div class="cookie-actions">
    <button type="button" class="btn btn-outline-primary" data-cookie-reject>
      {text("reject")}
    </button>
    <button type="button" class="btn btn-primary" data-cookie-accept>
      {text("accept")}
    </button>
    <button type="button" class="cookie-customize" data-cookie-customize>
      {text("customize")}
    </button>
    <button
      type="button"
      class="btn btn-outline-primary cookie-save"
      data-cookie-save
      hidden
    >
      {text("save")}
    </button>
  </div>
</section>

<script>
  import {
    isAnalyticsLoaded,
    readConsent,
    removeAnalyticsCookies,
    saveConsent,
    startAnalytics,
  } from "../lib/consent";

  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]");

  if (banner) {
    const find = <T extends HTMLElement>(name: string) =>
      banner.querySelector<T>(`[data-cookie-${name}]`)!;

    const options = find("options");
    const analytics = find<HTMLInputElement>("analytics");
    const customize = find("customize");
    const save = find("save");
    const title = banner.querySelector<HTMLElement>("h2")!;

    const setCustomizing = (isCustomizing: boolean) => {
      options.hidden = !isCustomizing;
      customize.hidden = isCustomizing;
      save.hidden = !isCustomizing;
    };

    const open = (isCustomizing: boolean) => {
      analytics.checked = readConsent()?.analytics ?? false;
      setCustomizing(isCustomizing);
      banner.hidden = false;
    };

    const decide = (accepted: boolean) => {
      const wasRunning = isAnalyticsLoaded();

      saveConsent({ analytics: accepted });
      banner.hidden = true;

      if (accepted) {
        startAnalytics();
      } else if (wasRunning) {
        // Analytics cannot be unloaded from a running page: delete its
        // cookies and start over without it.
        removeAnalyticsCookies();
        location.reload();
      }
    };

    find("accept").addEventListener("click", () => decide(true));
    find("reject").addEventListener("click", () => decide(false));
    save.addEventListener("click", () => decide(analytics.checked));
    customize.addEventListener("click", () => {
      setCustomizing(true);
      analytics.focus();
    });

    // Reopened by the visitor: Escape closes it again without a change.
    banner.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && readConsent()) banner.hidden = true;
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (
        target instanceof Element &&
        target.closest("[data-cookie-settings]")
      ) {
        event.preventDefault();
        open(true);
        title.focus();
      }
    });

    if (!readConsent()) open(false);
  }
</script>

<style>
  .cookie-banner {
    position: fixed;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--text);
    box-shadow: var(--shadow-lg), var(--shadow-media);
    font-size: 0.875rem;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .cookie-banner {
      right: auto;
      bottom: 24px;
      left: 24px;
      width: 420px;
      padding: 24px;
    }
  }

  h2 {
    font-size: 20px;
    color: var(--blue);
  }

  h2:focus {
    outline: none;
  }

  .cookie-policy-link {
    font-weight: 600;
    color: var(--blue);
    text-decoration: underline;
  }

  .cookie-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cookie-options[hidden] {
    display: none;
  }

  .cookie-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
  }

  .cookie-option-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .cookie-option-text strong {
    color: var(--blue);
  }

  /* A switch drawn from a plain checkbox, so it stays a native control. */
  .cookie-switch {
    position: relative;
    flex-shrink: 0;
    width: 40px;
    height: 22px;
    margin: 0;
    border-radius: 9999px;
    background: #cbd5e0;
    appearance: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cookie-switch::before {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 9999px;
    background: var(--white);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease;
  }

  .cookie-switch:checked {
    background: var(--blue);
  }

  .cookie-switch:checked::before {
    transform: translateX(18px);
  }

  .cookie-switch:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cookie-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .cookie-actions .btn {
    padding: 0 0.75rem;
    font-size: 0.9375rem;
  }

  .cookie-customize,
  .cookie-save {
    grid-column: 1 / -1;
  }

  .cookie-customize {
    justify-self: center;
    padding: 0.25rem;
    border: 0;
    background: none;
    font-weight: 600;
    color: var(--blue);
    text-decoration: underline;
    cursor: pointer;
  }

  .cookie-actions [hidden] {
    display: none;
  }
</style>

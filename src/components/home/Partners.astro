---
import { PARTNERS } from "../../data/partners";
import { getTranslator } from "../../i18n";

/**
 * The organisations behind the work. Credibility is easier to show than to
 * claim, so the partners get their own block on the home page.
 */
interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<section class="partners">
  <div class="section-head">
    <h2>{t("pages.home.partners.heading")}</h2>
    <p>{t("pages.home.partners.subHeading")}</p>
  </div>
  <ul class="partner-grid">
    {PARTNERS.map(({ name, logo, url }) => {
      const Plate = url ? "a" : "div";
      const linkProps = url
        ? { href: url, target: "_blank", rel: "noreferrer" }
        : {};

      return (
        <li>
          <Plate class="partner-plate" {...linkProps}>
            {logo ? (
              <img src={logo} alt={name} loading="lazy" />
            ) : (
              <h3>{name}</h3>
            )}
          </Plate>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .partners {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .partners .section-head p {
    max-width: 800px;
  }

  .partner-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .partner-plate {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 110px;
    padding: 20px;
    text-align: center;
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    transition: border-color 0.2s ease;
  }

  a.partner-plate:hover {
    border-color: var(--blue);
  }

  .partner-plate h3 {
    font-size: 18px;
    color: var(--blue);
  }

  .partner-plate img {
    max-height: 70px;
    object-fit: contain;
  }

  @media (min-width: 480px) {
    .partner-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 992px) {
    .partner-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
import { getTranslator } from "../../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<figure class="quote">
  <blockquote>“{t("pages.home.quote.quoteText")}”</blockquote>
  <figcaption>- Böjte Csaba</figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 50px;
    background-color: lightgrey;
    background-image: url(/assets/img/background/background-cross.jpg);
    background-size: cover;
  }

  blockquote {
    font-size: 24px;
  }

  figcaption {
    min-width: 30%;
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    figcaption {
      margin-left: auto;
    }
  }

  @media (min-width: 992px) {
    .quote {
      border-radius: var(--radius);
    }

    blockquote {
      max-width: 750px;
    }
  }

  @media (min-width: 1536px) {
    figcaption {
      min-width: 40%;
    }
  }
</style>

---
import { getTranslator } from "../../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
---

<figure class="quote">
  <span class="quote-mark" aria-hidden="true">
    “
  </span>
  <blockquote>{t("pages.home.quote.quoteText")}</blockquote>
  <figcaption>Böjte Csaba</figcaption>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .quote-mark {
    height: 0.5em;
    font-family: var(--font-heading);
    font-size: 96px;
    font-weight: 700;
    line-height: 1;
    color: var(--blue);
    opacity: 0.25;
  }

  blockquote {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--blue);
  }

  figcaption {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  figcaption::before {
    content: "— ";
  }

  @media (min-width: 768px) {
    blockquote {
      font-size: 30px;
    }
  }
</style>

---
import LiteYouTube from "../LiteYouTube.astro";
import { getTranslator, trans } from "../../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const statement = trans(t("pages.home.missionStatement"), {
  0: "h2",
  1: "p",
  2: "p",
  3: "p",
});
---

<section class="video-group">
  <div class="video-group-text" set:html={statement} />
  <div class="video-group-player">
    <LiteYouTube
      videoId="09MPqyp8ggE"
      title="Határtalan Segítség Alapítvány"
      playLabel={t("ui.video.play")}
      class="media-frame"
    />
  </div>
</section>

<style>
  /* Sits on a dark band (see Home.astro). */
  .video-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .video-group-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .video-group-text :global(h2) {
    max-width: 600px;
    font-size: 28px;
  }

  .video-group-text :global(p) {
    max-width: 700px;
    color: var(--white-90);
  }

  @media (min-width: 768px) {
    .video-group-text :global(h2) {
      font-size: 36px;
    }
  }

  @media (min-width: 992px) {
    .video-group {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3.5rem;
    }

    .video-group-text {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

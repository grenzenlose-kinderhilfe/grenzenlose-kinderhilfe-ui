---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="embed-map">
  <iframe src={src} title={title} loading="lazy"></iframe>
</div>

<style>
  .embed-map {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  iframe {
    width: 100%;
    aspect-ratio: 1;
    border: 0;
  }

  @media (min-width: 768px) {
    iframe {
      aspect-ratio: 16 / 7;
    }
  }
</style>

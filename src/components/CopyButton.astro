---
import { FiCheck, FiCopy } from "react-icons/fi";

import { getTranslator } from "../i18n";

/**
 * Copies `value` to the clipboard, so donors do not have to retype an IBAN or
 * a phone number. Hidden where the clipboard API is not available.
 */
interface Props {
  locale: string;
  value: string;
  /** What is being copied ("IBAN"), for screen readers. */
  label: string;
}

const { locale, value, label } = Astro.props;
const t = getTranslator(locale);
---

<button
  type="button"
  class="copy-button"
  data-copy={value}
  data-copied-label={t("ui.copy.copied")}
  aria-label={`${t("ui.copy.copy")}: ${label}`}
>
  <FiCopy className="copy-icon" aria-hidden="true" />
  <FiCheck className="copied-icon" aria-hidden="true" />
  <span class="copy-text" data-copy-text>
    {t("ui.copy.copy")}
  </span>
  <span class="copy-text" data-copied-text aria-live="polite"></span>
</button>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".copy-button")
    .forEach((button) => {
      if (!navigator.clipboard) {
        button.hidden = true;
        return;
      }

      const status = button.querySelector("[data-copied-text]");
      let timer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
          return;
        }

        button.classList.add("is-copied");
        if (status) status.textContent = button.dataset.copiedLabel ?? "";

        clearTimeout(timer);
        timer = setTimeout(() => {
          button.classList.remove("is-copied");
          if (status) status.textContent = "";
        }, 2000);
      });
    });
</script>

<style>
  .copy-button {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--blue);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .copy-button:hover {
    border-color: var(--blue);
  }

  .copy-button[hidden] {
    display: none;
  }

  .copied-icon,
  [data-copied-text]:empty,
  .is-copied .copy-icon,
  .is-copied [data-copy-text] {
    display: none;
  }

  .is-copied {
    border-color: var(--success);
    color: var(--success);
  }

  .is-copied .copied-icon {
    display: block;
  }
</style>

---
import {
  PLAYER_ALLOW,
  youtubePlayerUrl,
  youtubeThumbnailUrl,
} from "../lib/youtube";

interface Props {
  videoId: string;
  title: string;
  playLabel: string;
  class?: string;
}

/**
 * Click-to-play YouTube video for static markup (see src/lib/youtube.js).
 * Islands use src/islands/LiteYouTube.jsx, which renders the same markup.
 */
const { videoId, title, playLabel, class: className } = Astro.props;
---

<div
  class:list={["video-frame", "lite-youtube", className]}
  data-player-url={youtubePlayerUrl(videoId)}
>
  <button
    type="button"
    class="lite-youtube-button"
    aria-label={`${playLabel}: ${title}`}
  >
    <img
      src={youtubeThumbnailUrl(videoId)}
      alt=""
      loading="lazy"
      width="480"
      height="360"
    />
    <svg
      class="lite-youtube-play"
      viewBox="0 0 68 48"
      width="68"
      height="48"
      aria-hidden="true"
    >
      <path
        d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z"
        fill="#f00"
      ></path>
      <path d="M45 24 27 14v20z" fill="#fff"></path>
    </svg>
  </button>
  <iframe hidden title={title} allow={PLAYER_ALLOW} allowfullscreen></iframe>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".lite-youtube").forEach((frame) => {
    const button = frame.querySelector("button");
    const iframe = frame.querySelector("iframe");

    button?.addEventListener(
      "click",
      () => {
        if (!iframe) return;

        iframe.src = frame.dataset.playerUrl ?? "";
        iframe.hidden = false;
        button.remove();
        iframe.focus();
      },
      { once: true },
    );
  });
</script>

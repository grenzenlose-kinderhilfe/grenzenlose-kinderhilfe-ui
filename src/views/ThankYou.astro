---
import {
  FaEnvelope,
  FaHeart,
  FaReceipt,
  FaSyncAlt,
  FaTruck,
} from "react-icons/fa";

import { ORGANIZATION } from "../data/organization";
import { STRIPE_CUSTOMER_PORTAL_URL } from "../data/paymentLinks";
import { getTranslator, localizePath } from "../i18n";

/**
 * Where Stripe sends donors after a successful card donation (the Payment
 * Links' "After payment" redirect). It is kept out of the navigation, the
 * sitemap and search results.
 */
interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);
const thanks = (key: string) => t(`pages.thankYou.${key}`);

const steps = [
  { key: "receipt", icon: FaReceipt },
  { key: "transport", icon: FaTruck },
];
---

<div class="thanks">
  <section class="thanks-head">
    <div class="container thanks-head-inner">
      <span class="thanks-icon">
        <FaHeart aria-hidden="true" />
      </span>
      <h1>{thanks("heading")}</h1>
      <p class="thanks-lead">{thanks("lead")}</p>
    </div>
  </section>

  <section class="band band-tint" aria-labelledby="thanks-next">
    <div class="container thanks-body">
      <h2 id="thanks-next">{thanks("nextHeading")}</h2>
      <ul class="thanks-steps">
        {steps.map(({ key, icon: Icon }) => (
          <li class="card">
            <span class="icon-badge">
              <Icon aria-hidden="true" />
            </span>
            <p>{thanks(key)}</p>
          </li>
        ))}
        {STRIPE_CUSTOMER_PORTAL_URL && (
          <li class="card">
            <span class="icon-badge">
              <FaSyncAlt aria-hidden="true" />
            </span>
            <div class="thanks-manage">
              <p>{thanks("manage")}</p>
              <a
                class="btn btn-sm btn-primary"
                href={STRIPE_CUSTOMER_PORTAL_URL}
                data-track="manage_subscription"
                data-track-placement="thank_you"
              >
                {thanks("manageButton")}
              </a>
            </div>
          </li>
        )}
        <li class="card">
          <span class="icon-badge">
            <FaEnvelope aria-hidden="true" />
          </span>
          <p>
            {thanks("questions")}{" "}
            <a
              class="text-link"
              href={`mailto:${ORGANIZATION.email}`}
              data-track-context="thank_you"
            >
              {ORGANIZATION.email}
            </a>
          </p>
        </li>
      </ul>
      <div class="thanks-actions">
        <a class="btn btn-lg btn-primary" href={localizePath(locale, "/media")}>
          {thanks("mediaButton")}
        </a>
        <a class="text-link" href={localizePath(locale, "/")}>
          {thanks("homeButton")}
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { donationParams, takeDonation, track } from "../lib/analytics";

  /*
   * The completed donation, as the donor picked it on the site before going
   * to Stripe. Without that selection (storage blocked, or the page opened
   * directly) nothing is reported.
   */
  const donation = takeDonation();

  if (donation) {
    track("purchase", {
      transaction_id: donation.id,
      ...donationParams(donation),
    });
  }
</script>

<style>
  .thanks-head {
    padding-block: 48px;
    color: var(--white);
    background: var(--blue);
  }

  .thanks-head-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .thanks-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin-bottom: 0.5rem;
    border-radius: 9999px;
    background: var(--white);
    color: var(--blue);
  }

  .thanks-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .thanks-head h1 {
    font-size: 32px;
  }

  .thanks-lead {
    max-width: 640px;
    font-size: 16px;
    color: var(--white-90);
  }

  .thanks-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 760px;
  }

  .thanks-body h2 {
    font-size: 24px;
    text-align: center;
  }

  .thanks-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 0;
    list-style: none;
  }

  .thanks-steps .card {
    flex-direction: row;
    align-items: center;
    height: auto;
    border-color: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .thanks-steps p {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .thanks-manage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .thanks-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .thanks-head {
      padding-block: 64px;
    }

    .thanks-head h1 {
      font-size: 44px;
    }

    .thanks-lead {
      font-size: 18px;
    }
  }
</style>

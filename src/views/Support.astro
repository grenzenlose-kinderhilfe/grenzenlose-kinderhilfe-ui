---
import {
  FaCreditCard,
  FaGift,
  FaHandsHelping,
  FaMobileAlt,
  FaUniversity,
} from "react-icons/fa";

import DonationJourney from "../components/DonationJourney.astro";
import EmbedMap from "../components/EmbedMap.astro";
import SupportOption from "../components/SupportOption.astro";
import { DONATION_MAP_EMBED_URL } from "../constants";
import { BANK_ACCOUNT, ORGANIZATION, TWINT } from "../data/organization";
import Donate from "../islands/Donate/Donate.jsx";
import { hasPaymentLinks } from "../lib/amount";
import { getTranslator } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const option = (id: string) => ({
  title: t(`pages.support.options.${id}.title`),
  description: t(`pages.support.options.${id}.description`),
  spending: t(`pages.support.options.${id}.spending`),
  spendingLabel: t("pages.support.spendingLabel"),
});

const bankDetails = [
  ["Bank", BANK_ACCOUNT.bank],
  ["SWIFT", BANK_ACCOUNT.swift],
  ["IBAN", BANK_ACCOUNT.iban],
];

const donateStrings = {
  button: t("ui.donate.button"),
  presetLabel: t("ui.donate.presetLabel"),
  customLabel: t("ui.donate.customLabel"),
  currencyLabel: t("ui.donate.currencyLabel"),
  successTitle: t("ui.donate.successTitle"),
  close: t("ui.navigation.close"),
};

const mapHeading = t("pages.support.mapHeading");
---

<div class="support">
  <div class="support-head">
    <h1>{t("pages.support.heading")}</h1>
    <p class="support-lead">{t("pages.support.lead")}</p>
    <p class="support-org">
      {ORGANIZATION.name} · {t("pages.aboutUs.taxNumber")}:{" "}
      {ORGANIZATION.taxNumber}
    </p>
  </div>

  <div class:list={["support-options", { "with-card": hasPaymentLinks }]}>
    {hasPaymentLinks && (
      <SupportOption icon={FaCreditCard} {...option("online")}>
        <Donate client:load locale={locale} strings={donateStrings} />
      </SupportOption>
    )}
    <SupportOption icon={FaUniversity} {...option("transfer")}>
      <dl class="bank-details">
        {bankDetails.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </SupportOption>
    <SupportOption icon={FaMobileAlt} {...option("twint")}>
      <div class="twint">
        <a class="text-link twint-phone" href={`tel:${TWINT.phone}`}>
          {TWINT.phone}
        </a>
        <p>{TWINT.name}</p>
        <a class="text-link" href={`mailto:${TWINT.email}`}>
          {TWINT.email}
        </a>
      </div>
    </SupportOption>
    <SupportOption icon={FaGift} {...option("inKind")}>
      <a
        class="btn btn-block btn-primary"
        href={`mailto:${ORGANIZATION.email}`}
      >
        {t("pages.support.options.inKind.action")}
      </a>
    </SupportOption>
    <SupportOption icon={FaHandsHelping} {...option("volunteer")}>
      <a
        class="btn btn-block btn-primary"
        href={`mailto:${ORGANIZATION.email}`}
      >
        {t("pages.support.options.volunteer.action")}
      </a>
    </SupportOption>
  </div>

  <DonationJourney locale={locale} />

  <section class="support-map">
    <h2>{mapHeading}</h2>
    <EmbedMap src={DONATION_MAP_EMBED_URL} title={mapHeading} />
  </section>
</div>

<style>
  .support {
    display: grid;
    gap: 3rem;
    margin: 25px;
  }

  .support-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .support-head h1 {
    font-size: 32px;
  }

  .support-lead {
    max-width: 800px;
    font-size: 16px;
  }

  .support-org {
    font-size: 14px;
    color: var(--blue);
  }

  .support-options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .bank-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bank-details div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bank-details dt {
    font-size: 13px;
    font-weight: 700;
  }

  .bank-details dd {
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--grey);
    font-size: 14px;
    word-break: break-word;
  }

  .twint {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 14px;
  }

  .twint-phone {
    font-size: 1rem;
    font-weight: 700;
  }

  .support-map {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .support-map h2 {
    font-size: 28px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .support-head h1 {
      font-size: 44px;
    }

    .support-lead {
      font-size: 18px;
    }

    .support-options {
      grid-template-columns: repeat(2, 1fr);
    }

    .support-map h2 {
      font-size: 36px;
    }
  }

  @media (min-width: 992px) {
    .support {
      margin: 25px 50px;
    }
  }

  @media (min-width: 1280px) {
    .support {
      margin: 50px;
    }

    .support-options.with-card {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1536px) {
    .support-options:not(.with-card) {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

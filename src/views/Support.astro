---
import {
  FaCreditCard,
  FaGift,
  FaHandsHelping,
  FaMobileAlt,
  FaSyncAlt,
  FaUniversity,
} from "react-icons/fa";

import DonationJourney from "../components/DonationJourney.astro";
import EmbedMap from "../components/EmbedMap.astro";
import SupportOption from "../components/SupportOption.astro";
import { DONATION_MAP_EMBED_URL, DONATION_MAP_VIEWER_URL } from "../constants";
import PaymentDetails from "../components/PaymentDetails.astro";
import { ORGANIZATION } from "../data/organization";
import { STRIPE_CUSTOMER_PORTAL_URL } from "../data/paymentLinks";
import Donate from "../islands/Donate/Donate.jsx";
import { hasPaymentLinks } from "../lib/amount";
import { getTranslator } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const option = (id: string) => ({
  title: t(`pages.support.options.${id}.title`),
  description: t(`pages.support.options.${id}.description`),
  spending: t(`pages.support.options.${id}.spending`),
  spendingLabel: t("pages.support.spendingLabel"),
});

const donateStrings = {
  button: t("ui.donate.button"),
  presetLabel: t("ui.donate.presetLabel"),
  customLabel: t("ui.donate.customLabel"),
  frequencyLabel: t("ui.donate.frequencyLabel"),
  monthly: t("ui.donate.monthly"),
  once: t("ui.donate.once"),
  perMonth: t("ui.donate.perMonth"),
  currencyLabel: t("ui.donate.currencyLabel"),
};

const mapHeading = t("pages.support.mapHeading");
---

<div class="support">
  <section class="support-head">
    <div class="container support-head-inner">
      <h1>{t("pages.support.heading")}</h1>
      <p class="support-lead">{t("pages.support.lead")}</p>
      <p class="support-org">
        {ORGANIZATION.name} · {t("pages.aboutUs.taxNumber")}:{" "}
        {ORGANIZATION.taxNumber}
      </p>
    </div>
  </section>

  <section class="band band-tint" aria-label={t("pages.support.heading")}>
    <div class="container">
      <div class:list={["support-options", { "with-card": hasPaymentLinks }]}>
        {hasPaymentLinks && (
          <SupportOption icon={FaCreditCard} {...option("online")}>
            <Donate client:load locale={locale} strings={donateStrings} />
            {STRIPE_CUSTOMER_PORTAL_URL && (
              <p class="support-manage">
                <span>{t("pages.support.manageMonthly")}</span>
                <a
                  class="support-manage-link"
                  href={STRIPE_CUSTOMER_PORTAL_URL}
                >
                  <FaSyncAlt aria-hidden="true" />
                  {t("pages.support.manageLink")}
                </a>
              </p>
            )}
          </SupportOption>
        )}
        <SupportOption icon={FaUniversity} {...option("transfer")}>
          <PaymentDetails locale={locale} method="bank" />
        </SupportOption>
        <SupportOption icon={FaMobileAlt} {...option("twint")}>
          <PaymentDetails locale={locale} method="twint" />
        </SupportOption>
        <SupportOption icon={FaGift} {...option("inKind")}>
          <a
            class="btn btn-block btn-primary"
            href={`mailto:${ORGANIZATION.email}`}
          >
            {t("pages.support.options.inKind.action")}
          </a>
        </SupportOption>
        <SupportOption icon={FaHandsHelping} {...option("volunteer")}>
          <a
            class="btn btn-block btn-primary"
            href={`mailto:${ORGANIZATION.email}`}
          >
            {t("pages.support.options.volunteer.action")}
          </a>
        </SupportOption>
      </div>
    </div>
  </section>

  <div class="band">
    <div class="container">
      <DonationJourney locale={locale} />
    </div>
  </div>

  <section class="band band-tint" aria-labelledby="support-map">
    <div class="container support-map">
      <div class="section-head">
        <h2 id="support-map">{mapHeading}</h2>
        <p>{t("pages.support.mapLead")}</p>
      </div>
      <EmbedMap
        locale={locale}
        src={DONATION_MAP_EMBED_URL}
        viewerUrl={DONATION_MAP_VIEWER_URL}
        title={mapHeading}
      />
    </div>
  </section>
</div>

<style>
  /*
   * Bands as on the home page: dark header, payment options on tint, the
   * donation journey on white and the map on tint (the footer is dark).
   */
  .support {
    min-width: 0;
  }

  .support-head {
    padding-block: 48px;
    color: var(--white);
    background: var(--blue);
  }

  .support-head-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .support-head h1 {
    font-size: 32px;
  }

  .support-lead {
    max-width: 700px;
    font-size: 16px;
    color: var(--white-90);
  }

  .support-org {
    font-size: 14px;
    color: var(--white-80);
  }

  .support-options {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .support-options :global(.card) {
    border-color: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .support-manage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-top: 1rem;
    font-size: 14px;
    text-align: center;
  }

  .support-manage-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .support-manage-link:hover {
    text-decoration-thickness: 2px;
  }

  .support-manage-link :global(svg) {
    flex-shrink: 0;
    width: 0.85em;
    height: 0.85em;
  }

  .support-map {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .support-head {
      padding-block: 64px;
    }

    .support-head h1 {
      font-size: 44px;
    }

    .support-lead {
      font-size: 18px;
    }

    .support-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .support-options.with-card {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

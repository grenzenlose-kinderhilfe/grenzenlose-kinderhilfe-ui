---
import DonationJourney from "../components/DonationJourney.astro";
import Campaigns from "../components/home/Campaigns.astro";
import Counters from "../components/home/Counters.astro";
import Hero from "../components/home/Hero.astro";
import Mission from "../components/home/Mission.astro";
import Partners from "../components/home/Partners.astro";
import Quote from "../components/home/Quote.astro";
import VideoGroup from "../components/home/VideoGroup.astro";
import SlideShow from "../islands/SlideShow.jsx";
import { buildFeaturedPosts } from "../lib/buildContent";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const initialSlides = await buildFeaturedPosts(locale);

/*
 * Every block is a full-width band; the tones alternate (dark, white, tint)
 * so neighbouring blocks never blend into each other. The footer is dark, so
 * the last band is not.
 */
---

<div class="home">
  <Hero locale={locale}>
    <SlideShow client:load locale={locale} initialSlides={initialSlides} />
  </Hero>

  <div class="band">
    <div class="container">
      <Counters locale={locale} />
    </div>
  </div>

  <div class="band band-tint">
    <div class="container">
      <Campaigns locale={locale} />
    </div>
  </div>

  <div class="band band-dark">
    <div class="container">
      <VideoGroup locale={locale} />
    </div>
  </div>

  <div class="band">
    <div class="container">
      <DonationJourney locale={locale} />
    </div>
  </div>

  <div class="band band-tint">
    <div class="container">
      <Mission locale={locale} />
    </div>
  </div>

  <div class="band">
    <div class="container">
      <Partners locale={locale} />
    </div>
  </div>

  <div class="band band-tint">
    <div class="container">
      <Quote locale={locale} />
    </div>
  </div>
</div>

<style>
  .home {
    min-width: 0;
  }

  .home :global(.container) > :global(*) {
    min-width: 0;
  }
</style>

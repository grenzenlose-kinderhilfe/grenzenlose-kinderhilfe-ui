---
import { Image } from "astro:assets";
import { FaBoxOpen, FaGift, FaHeart, FaTruck } from "react-icons/fa";
import { FiArrowUpRight } from "react-icons/fi";

import shoeboxImage from "../assets/shoebox.png";
import EmbedMap from "../components/EmbedMap.astro";
import LiteYouTube from "../components/LiteYouTube.astro";
import {
  DONATION_MAP_EMBED_URL,
  DONATION_MAP_VIEWER_URL,
  LOCALE_HU,
  WORDPRESS_SHOEBOX_CATEGORIES,
  WORDPRESS_SHOEBOX_CATEGORY_URLS,
} from "../constants";
import Donate from "../islands/Donate/Donate.jsx";
import ShoeboxNews from "../islands/ShoeboxNews/ShoeboxNews.jsx";
import { buildShoeboxPosts } from "../lib/buildContent";
import { hasPaymentLinks } from "../lib/amount";
import { getTranslator, localizePath } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const main = (key: string) => t(`pages.Shoebox.MainContentGroup.${key}`);
const fundraiser = (key: string) => t(`pages.Shoebox.Fundraiser.${key}`);
const howTo = (key: string) => t(`pages.Shoebox.HowTo.${key}`);
const news = (key: string) => t(`pages.Shoebox.News.${key}`);

// Hungarian video for Hungarian, the German one for everyone else.
const videoId = locale === LOCALE_HU ? "tIL6BPiSY1w" : "h__srWvtSK4";

const steps = [
  { key: "makeBox", icon: FaBoxOpen },
  { key: "donate", icon: FaTruck },
  { key: "happy", icon: FaGift },
];

type Locale = keyof typeof WORDPRESS_SHOEBOX_CATEGORIES;

const blogCategoryId = WORDPRESS_SHOEBOX_CATEGORIES[locale as Locale];
const blogCategoryUrl = WORDPRESS_SHOEBOX_CATEGORY_URLS[locale as Locale];
const initialPosts = await buildShoeboxPosts(locale);

const mapHeading = t("pages.support.mapHeading");

const donateStrings = {
  button: t("ui.donate.button"),
  presetLabel: t("ui.donate.presetLabel"),
  customLabel: t("ui.donate.customLabel"),
  frequencyLabel: t("ui.donate.frequencyLabel"),
  monthly: t("ui.donate.monthly"),
  once: t("ui.donate.once"),
  perMonth: t("ui.donate.perMonth"),
  currencyLabel: t("ui.donate.currencyLabel"),
};
---

<div class="shoebox">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>{main("titleHeading")}</h1>
        <p class="hero-lead">{main("titleHeadingSub")}</p>
        <p>{main("shoeboxMagic")}</p>
        <a class="btn btn-lg btn-light" href="#donate">
          <FaHeart aria-hidden="true" />
          {fundraiser("actionButton")}
        </a>
      </div>
      <div class="hero-media">
        <Image
          src={shoeboxImage}
          alt={main("imageAlt")}
          widths={[480, 800, shoeboxImage.width]}
          sizes="(min-width: 992px) 600px, 100vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="shoebox-how">
    <div class="container how">
      <div class="section-head">
        <h2 id="shoebox-how">{howTo("heading")}</h2>
      </div>
      <ol class="steps">
        {steps.map(({ key, icon: Icon }, idx) => (
          <li class="step">
            <span class="step-icon" aria-hidden="true">
              <Icon />
              <span class="step-number">{idx + 1}</span>
            </span>
            <h3>{howTo(`steps.${key}.title`)}</h3>
            <p>{howTo(`steps.${key}.text`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band-dark" aria-labelledby="shoebox-join">
    <div class="container join">
      <div class="join-text">
        <h2 id="shoebox-join">{main("joinUs")}</h2>
        <p>{main("community")}</p>
        <p>{main("attention")}</p>
      </div>
      <LiteYouTube
        videoId={videoId}
        title={fundraiser("videoTitle")}
        playLabel={t("ui.video.play")}
        class="media-frame"
      />
    </div>
  </section>

  <section id="donate" class="band band-tint" aria-labelledby="shoebox-donate">
    <div class="container">
      <div class="donate-card">
        <h2 id="shoebox-donate">{fundraiser("actionTextHeading")}</h2>
        {hasPaymentLinks ? (
          <Donate
            client:visible
            locale={locale}
            strings={donateStrings}
            showLabel={false}
          />
        ) : (
          <a
            class="btn btn-lg btn-primary"
            href={localizePath(locale, "/support")}
          >
            <FaHeart aria-hidden="true" />
            {fundraiser("actionButton")}
          </a>
        )}
        <p>{fundraiser("actionTextInstruction")}</p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="shoebox-news">
    <div class="container news">
      <div class="section-head">
        <h2 id="shoebox-news">{news("heading")}</h2>
      </div>
      <ShoeboxNews
        client:visible
        locale={locale}
        categoryId={blogCategoryId}
        initialPosts={initialPosts}
      />
      <a
        class="btn btn-lg btn-primary"
        href={blogCategoryUrl}
        target="_blank"
        rel="noreferrer"
      >
        {news("allPosts")}
        <FiArrowUpRight aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="band band-tint" aria-labelledby="shoebox-map">
    <div class="container map">
      <div class="section-head">
        <h2 id="shoebox-map">{mapHeading}</h2>
        <p>{t("pages.support.mapLead")}</p>
      </div>
      <EmbedMap
        locale={locale}
        src={DONATION_MAP_EMBED_URL}
        viewerUrl={DONATION_MAP_VIEWER_URL}
        title={mapHeading}
      />
    </div>
  </section>
</div>

<style>
  /*
   * Full-width bands alternating dark, white and tint (see global.css), the
   * same rhythm as the home page. The footer is dark, so the last band is not.
   */
  .shoebox {
    min-width: 0;
  }

  /* Hero */

  .hero {
    padding-block: 48px;
    color: var(--white);
    background: var(--blue);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .hero-text h1 {
    max-width: 600px;
    font-size: 2.25rem;
  }

  .hero-text p {
    max-width: 640px;
    color: var(--white-90);
  }

  .hero-text .hero-lead {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--white);
  }

  .hero-text .btn {
    margin-top: 0.5rem;
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .hero-media img {
    width: 100%;
    max-width: 600px;
    height: auto;
  }

  /* Shared column layout for the sections below the hero */

  .how,
  .news,
  .map {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* How it works */

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-align: center;
  }

  .step-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 9999px;
    background: var(--blue);
    color: var(--white);
    font-size: 1.75rem;
  }

  .step-number {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--white);
    border-radius: 9999px;
    background: #f6c344;
    color: var(--blue);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .step h3 {
    font-size: 1.5rem;
    color: var(--blue);
  }

  /* Join us, next to the campaign video */

  .join {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .join-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .join-text h2 {
    font-size: 28px;
  }

  .join-text p {
    max-width: 640px;
    color: var(--white-90);
  }

  /* Donate */

  .donate-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 720px;
    margin-inline: auto;
    padding: 32px 20px;
    text-align: center;
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 4px solid var(--blue);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .donate-card h2 {
    max-width: 560px;
    font-size: 26px;
  }

  /* News */

  .news {
    align-items: center;
  }

  .news :global(.shoebox-news) {
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 72px;
    }

    .hero-text h1 {
      font-size: 2.75rem;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .join-text h2 {
      font-size: 36px;
    }

    .donate-card {
      padding: 48px;
    }

    .donate-card h2 {
      font-size: 32px;
    }
  }

  @media (min-width: 992px) {
    .hero-inner,
    .join {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
    }

    .hero-text,
    .join-text {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

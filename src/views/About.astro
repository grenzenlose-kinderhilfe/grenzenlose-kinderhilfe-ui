---
import { BsTelephoneFill } from "react-icons/bs";
import { HiOutlineDocumentText } from "react-icons/hi";
import { IoMdDocument } from "react-icons/io";
import { MdEmail, MdLocationPin } from "react-icons/md";

import {
  CONTACTS,
  FOUNDING_DOCUMENTS,
  ORGANIZATION,
} from "../data/organization";
import { getTranslator, trans } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const about = (key: string) => t(`pages.aboutUs.${key}`);

const heading = trans(about("contentHeader"), { 1: "br", 3: "br" });
const story = trans(about("contentText"), {
  0: "p",
  1: "p",
  2: "p",
  3: "p",
  4: "p",
});
---

<div class="about">
  <section class="band">
    <div class="container story">
      <img
        class="story-image"
        src="/assets/img/about-us.jpg"
        alt={about("imageAlt")}
        width="1200"
        height="1600"
        loading="eager"
      />
      <div class="story-text">
        <h1 set:html={heading} />
        <div class="story-body" set:html={story} />
      </div>
    </div>
  </section>

  <section class="band band-tint" aria-labelledby="about-contact">
    <div class="container contact">
      <h2 id="about-contact" class="visually-hidden">
        {t("ui.footer.contact")}
      </h2>

      <div class="contact-grid">
        <article class="info-card">
          <h3>{t("ui.footer.contact")}</h3>
          <ul class="people">
            {CONTACTS.map(({ name, roleKey, phone }) => (
              <li>
                <p class="person-name">{name}</p>
                <p class="eyebrow">{about(roleKey)}</p>
                <p class="info-line">
                  <BsTelephoneFill aria-hidden="true" />
                  <a class="text-link" href={`tel:+${phone}`}>
                    +{phone}
                  </a>
                </p>
              </li>
            ))}
          </ul>
        </article>

        <article class="info-card">
          <h3>{t("ui.footer.organization")}</h3>
          <p class="person-name">{ORGANIZATION.name}</p>
          <ul class="info-list">
            <li class="info-line">
              <MdEmail aria-hidden="true" />
              <a class="text-link" href={`mailto:${ORGANIZATION.email}`}>
                {ORGANIZATION.email}
              </a>
            </li>
            <li class="info-line">
              <MdLocationPin aria-hidden="true" />
              {ORGANIZATION.address}
            </li>
            <li class="info-line">
              <HiOutlineDocumentText aria-hidden="true" />
              {about("taxNumber")}: {ORGANIZATION.taxNumber}
            </li>
            <li class="info-line">
              <IoMdDocument aria-hidden="true" />
              {about("documents")}:
              {FOUNDING_DOCUMENTS.map(({ url, labelKey }) => (
                <a class="tag text-link" href={url} download>
                  {about(labelKey)}
                </a>
              ))}
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>
</div>

<style>
  /* Two bands: the story on white, the contact and bank details on tint. */
  .about {
    min-width: 0;
  }

  /* Story */

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  .story-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 40%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 68ch;
  }

  .story-text h1 {
    font-size: 28px;
    color: var(--blue);
  }

  .story-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    line-height: 1.7;
  }

  /* Contact */

  .contact {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 24px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .info-card h3 {
    font-size: 20px;
    color: var(--blue);
  }

  .people {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .person-name {
    font-weight: 600;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .info-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  .info-line :global(svg) {
    flex-shrink: 0;
    color: var(--blue);
  }

  @media (min-width: 768px) {
    .story-text h1 {
      font-size: 36px;
    }

    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The photo is portrait: next to the text it is shown uncropped. */
  @media (min-width: 992px) {
    .story {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
      gap: 3.5rem;
    }

    .story-image {
      position: sticky;
      top: calc(var(--nav-height) + 1.5rem);
      aspect-ratio: 3 / 4;
    }
  }
</style>

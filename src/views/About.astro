---
import { BsTelephoneFill } from "react-icons/bs";
import { HiOutlineDocumentText } from "react-icons/hi";
import { IoMdDocument } from "react-icons/io";
import { MdEmail, MdLocationPin } from "react-icons/md";

import {
  BANK_ACCOUNT,
  CONTACTS,
  FOUNDING_DOCUMENTS,
  ORGANIZATION,
  TWINT,
} from "../data/organization";
import { getTranslator, trans } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const about = (key: string) => t(`pages.aboutUs.${key}`);

const heading = trans(about("contentHeader"), { 1: "br", 3: "br" });
const story = trans(about("contentText"), {
  0: "p",
  1: "p",
  2: "p",
  3: "p",
  4: "p",
});

const bankDetails = [
  ["Bank", BANK_ACCOUNT.bank],
  ["SWIFT-Code", BANK_ACCOUNT.swift],
  ["IBAN/BIC", BANK_ACCOUNT.iban],
  ["TWINT", `${TWINT.phone} ${TWINT.name}, ${about("founder")} ${TWINT.email}`],
];
---

<div class="about">
  <div class="about-story">
    <h1 class="heading-default" set:html={heading} />
    <div class="about-text" set:html={story} />
  </div>

  <img
    class="about-image"
    src="/assets/img/about-us.jpg"
    alt={ORGANIZATION.name}
    loading="lazy"
  />

  <div class="contact-group">
    {CONTACTS.map(({ name, roleKey, phone }) => (
      <div class="contact-card">
        <p class="contact-title">
          <strong>{name}</strong> - {about(roleKey)}
        </p>
        <p class="contact-line">
          <BsTelephoneFill aria-hidden="true" />
          <a class="text-link" href={`tel:+${phone}`}>
            + {phone}
          </a>
        </p>
      </div>
    ))}

    <div class="contact-card">
      <p class="contact-title">
        <strong>{ORGANIZATION.name}</strong>
      </p>
      <p class="contact-line">
        <MdEmail aria-hidden="true" />
        <a class="text-link" href={`mailto:${ORGANIZATION.email}`}>
          {ORGANIZATION.email}
        </a>
      </p>
      <p class="contact-line">
        <MdLocationPin aria-hidden="true" />
        {ORGANIZATION.address}
      </p>
      <p class="contact-line">
        <HiOutlineDocumentText aria-hidden="true" />
        {about("taxNumber")}: {ORGANIZATION.taxNumber}
      </p>
      <p class="contact-line">
        <IoMdDocument aria-hidden="true" />
        {about("foundingDocument")}:
        {FOUNDING_DOCUMENTS.map((link) => (
          <a class="tag text-link" href={link}>
            {about("link")}
          </a>
        ))}
      </p>
    </div>

    <dl class="contact-card">
      {bankDetails.map(([name, value]) => (
        <div class="contact-detail">
          <dt>{name}:</dt>
          <dd class="tag">{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
    margin-bottom: 25px;
  }

  .about-story {
    margin: 0 25px;
    text-align: center;
  }

  .about-story h1 {
    margin: 25px;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 10px;
    padding: 10px;
    border: 1px solid var(--blue);
    border-radius: var(--radius);
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }

  .contact-line :global(svg) {
    flex-shrink: 0;
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .contact-detail dd {
    padding-block: 0.125rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .about {
      margin-bottom: 0;
    }

    .about-image {
      aspect-ratio: 16 / 9;
    }
  }

  /* Wide screens: story, photo and contacts side by side. */
  @media (min-width: 1025px) {
    .about {
      grid-template-columns: 3fr 2fr 2fr;
      gap: 0;
      margin: 25px 50px;
    }

    .about-image {
      align-self: center;
      height: auto;
      margin: 25px;
      width: calc(100% - 50px);
      aspect-ratio: auto;
      object-fit: contain;
      border-radius: var(--radius);
    }

    .contact-group {
      align-self: center;
      margin: 0;
    }
  }
</style>

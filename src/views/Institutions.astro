---
import Institutions from "../islands/Institutions/Institutions.jsx";
import { buildLocations } from "../lib/buildContent";
import { getTranslator } from "../i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslator(locale);

const initialLocations = await buildLocations();

const countries = {
  HU: t("pages.donation.country.hungary"),
  RO: t("pages.donation.country.romania"),
  SK: t("pages.donation.country.slovakia"),
  UA: t("pages.donation.country.ukraine"),
  DE: t("pages.donation.country.germany"),
  AT: t("pages.donation.country.austria"),
  CH: t("pages.donation.country.switzerland"),
  XK: t("pages.donation.country.kosovo"),
};

const strings = {
  error: t("ui.data.error"),
  empty: t("ui.data.empty"),
};
---

<div class="institutions">
  <h1 class="heading-default">{t("pages.donation.supportedTitle")}</h1>
  <Institutions
    client:load
    strings={strings}
    countries={countries}
    initialLocations={initialLocations}
  />
</div>

<style>
  .institutions {
    display: grid;
    gap: 2rem;
    margin: 10px;
    text-align: center;
  }

  @media (min-width: 992px) {
    .institutions {
      margin: 25px;
    }
  }

  @media (min-width: 1280px) {
    .institutions {
      margin: 25px 50px;
    }
  }
</style>

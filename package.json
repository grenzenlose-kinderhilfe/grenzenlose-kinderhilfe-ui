    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.4.0",
    "i18next-parser": "^7.9.0",
    "lefthook": "^1.5.2",

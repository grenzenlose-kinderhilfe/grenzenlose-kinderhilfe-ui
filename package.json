  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "lefthook install",
    "build": "vite build",
    "serve": "vite serve",
    "zip": "pnpm exec 'cd build && /usr/bin/zip -r grenzenlose-kinderhilfe-ui.zip .'",

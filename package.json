{
  "name": "grenzenlose-kinderhilfe-ui",
  "homepage": "https://grenzenlose-kinderhilfe.com",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@paypal/react-paypal-js": "^8.9.2",
    "@tanstack/react-query": "^5.90.9",
    "framer-motion": "^7.10.3",
    "i18next": "^22.5.1",
    "i18next-browser-languagedetector": "^7.2.2",
    "i18next-http-backend": "^2.7.3",
    "luxon": "^3.7.2",
    "react": "^18.3.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.3.1",
    "react-ga4": "^1.4.1",
    "react-i18next": "^12.3.1",
    "react-icons": "^4.12.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.30.2",
    "swiper": "^8.4.7"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "lefthook install",
    "build": "rsbuild build --mode production && cd ./dist && zip -r ./grenzenlose-kinderhilfe.zip ./*",
    "serve": "rsbuild serve",
    "dev": "rsbuild dev",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint --fix --ext js,jsx .",
    "lint:prettier": "prettier --write .",
    "localization:parse": "rm -rf public/locales/hu-HU/ && i18next 'src/**/*.{js,jsx}'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.6",
    "@rsbuild/plugin-react": "^1.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "i18next-parser": "^7.9.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@8.9.0"
}
